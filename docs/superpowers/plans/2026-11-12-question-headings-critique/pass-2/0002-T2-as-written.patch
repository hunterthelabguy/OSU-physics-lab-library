+    def test_word_label_outside_h3_to_h5_fails(self):
+        # D-0176: Word has Question Label 3 to 5; an h2 label (no section
+        # above it) has no style, so the render stops.
+        out = self.render(q("a"), "-t", "docx", "-o", os.devnull)

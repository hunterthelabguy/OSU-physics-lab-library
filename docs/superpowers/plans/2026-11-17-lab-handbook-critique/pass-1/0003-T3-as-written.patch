+"""The em-dash scan reads a converted file's ruled additions (spec 4.7):
+new public wording, which the word check does not compare with an original."""
+
+import sys
+import tempfile
+import unittest
+from pathlib import Path
+
+ROOT = Path(__file__).resolve().parent.parent
+sys.path.insert(0, str(ROOT / "tools"))
+import check_em_dash  # noqa: E402
+
+DASH = "\u2014"
+
+
+def converted(addition, body="Words."):
+    return ('---\nid: x\nsource_file: "o.docx"\nruled_additions:\n  - text: "' + addition
+            + '"\n    ledger: "D-0000"\n---\n\n' + body + "\n")
+
+
+class RuledAdditions(unittest.TestCase):
+
+    def scan(self, text):
+        with tempfile.TemporaryDirectory() as d:
+            (Path(d) / "curriculum").mkdir()
+            (Path(d) / "curriculum" / "x.md").write_text(text, encoding="utf-8")
+            return check_em_dash.scan(d, ("curriculum",))
+
+    def test_dash_in_an_addition_is_found(self):
+        self.assertEqual(self.scan(converted("New " + DASH + " words")),
+                         ["curriculum/x.md (ruled_additions)"])
+
+    def test_dash_in_the_original_words_is_kept(self):
+        self.assertEqual(self.scan(converted("New words", body="Old " + DASH + " words")), [])
+
+    def test_repository_is_clean(self):
+        self.assertEqual(check_em_dash.scan(), [])

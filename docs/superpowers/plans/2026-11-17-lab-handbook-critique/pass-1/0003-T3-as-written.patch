+ADDITION = re.compile(r'^\s+(?:-\s+)?text:\s*"(.*)"\s*$')
+
+
+def added_text(path):
+    """The `text` of each `ruled_additions` entry in a file's front matter."""
+    with open(path, encoding="utf-8") as fh:
+        lines = fh.read().split("\n")
+    out, inside = [], False
+    for line in lines[1:]:
+        line = line.rstrip("\r")
+        if line == "---":
+            break
+        if line and not line[0].isspace():
+            inside = line.startswith("ruled_additions:")
+            continue
+        m = ADDITION.match(line) if inside else None
+        if m:
+            out.append(m.group(1))
+    return out
+

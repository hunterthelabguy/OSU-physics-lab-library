+def paragraph_text(p):
+    """A paragraph's characters, whitespace normalised (span edges, D-0189)."""
+    return " ".join("".join(t.text or "" for t in p.iter(W + "t")).split())
+
+
+def body_spans(body, spans, path):
+    """Each declared span (D-0189) as a half-open range of the Word body's
+    child indexes, sorted. An edge is the whole text of one paragraph at the
+    body's top level; `from` is inside, `to` is not."""
+    texts = [(i, paragraph_text(ch)) for i, ch in enumerate(body) if ch.tag == W + "p"]
+
+    def edge(span, key, default):
+        text = span.get(key)
+        if text is None:
+            return default
+        want = " ".join(str(text).split())
+        hits = [i for i, t in texts if t == want]
+        if not hits:
+            raise SystemExit(f"{path}: span {key} {want!r} matches no paragraph at the"
+                             " body's top level (an edge inside a table or text box is"
+                             " not supported; D-0189)")
+        n = span.get(key + "_occurrence")
+        if n is None:
+            if len(hits) > 1:
+                raise SystemExit(f"{path}: span {key} {want!r} matches {len(hits)} paragraphs"
+                                 f" (body children {hits}); name one with {key}_occurrence"
+                                 " (D-0189)")
+            return hits[0]
+        k = int(str(n))
+        if not 1 <= k <= len(hits):
+            raise SystemExit(f"{path}: span {key}_occurrence {k}, but {want!r} matches"
+                             f" {len(hits)} paragraphs (D-0189)")
+        return hits[k - 1]
+
+    out = []
+    for span in spans:
+        first, stop = edge(span, "from", 0), edge(span, "to", len(body))
+        if first >= stop:
+            raise SystemExit(f"{path}: span from {span.get('from')!r} has no paragraph"
+                             f" before its end {span.get('to')!r} (D-0189)")
+        if not any(t.text for k in range(first, stop) for t in body[k].iter(W + "t")):
+            raise SystemExit(f"{path}: span from {span.get('from')!r} holds no characters (D-0189)")
+        out.append((first, stop))
+    out.sort()
+    for (_, a_stop), (b_first, _) in zip(out, out[1:]):
+        if b_first < a_stop:
+            raise SystemExit(f"{path}: spans overlap (D-0189)")
+    return out
+

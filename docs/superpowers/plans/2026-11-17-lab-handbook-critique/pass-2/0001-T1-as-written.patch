+++ b/tests/test_check_em_dash.py
@@ -0,0 +1,36 @@
+"""The em-dash scan (D-0103, D-0195): a converted file keeps its original's
+em dashes; a ruled-change file is the site's own wording and is scanned."""
+
+import sys
+import tempfile
+import unittest
+from pathlib import Path
+
+ROOT = Path(__file__).resolve().parent.parent
+sys.path.insert(0, str(ROOT / "tools"))
+import check_em_dash  # noqa: E402
+
+DASH = "—"
+
+
+def source(status, body):
+    return '---\nid: x\nsource_file: "o.docx"\nstatus: ' + status + '\n---\n\n' + body + "\n"
+
+
+class Scan(unittest.TestCase):
+
+    def scan(self, text):
+        with tempfile.TemporaryDirectory() as d:
+            (Path(d) / "curriculum").mkdir()
+            (Path(d) / "curriculum" / "x.md").write_text(text, encoding="utf-8")
+            return check_em_dash.scan(d, ("curriculum",))
+
+    def test_converted_keeps_its_originals_dashes(self):
+        self.assertEqual(self.scan(source("converted", "Old " + DASH + " words")), [])
+
+    def test_ruled_change_is_scanned(self):
+        self.assertEqual(self.scan(source("ruled-change", "New " + DASH + " words")),
+                         ["curriculum/x.md"])
+
+    def test_repository_is_clean(self):
+        self.assertEqual(check_em_dash.scan(), [])
